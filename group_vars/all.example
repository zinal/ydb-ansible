# Configuration settings for all YDB cluster nodes

# Should only be defined when YDB cluster extension is performed.
# Must NOT be defined during the initial cluster setup.
# ydb_cluster_extension: true

ansible_python_interpreter: /usr/bin/python3

# YDB cluster domain (aka cluster identifier), Root in the documentation
ydb_domain: Domain0

# YDB software installation directory
ydb_dir: /opt/ydb

# Source directory with TLS keys and certificares
ydb_tls_dir: ./tls/CA/certs/2023-03-09_16-49-39

# YDB server software archive
ydb_archive: "ydbd-enterpise-{{ ydb_version }}-stable-linux-amd64.tar.xz"

# YDB server software release
ydb_version: 25.2.1.ent.4

# Extra options passed to tar for unpack, typically "--strip-component=1"
ydb_unpack_options: "--strip-component=1"

# Database name for the dynamic nodes
ydb_dbname: testdb

# YDB default storage pool kind, as specified in the static nodes
#   configuration file in the storage_pool_types.kind field
ydb_pool_kind: ssd

# Default number of groups per newly created database
ydb_default_groups: 9

# Name of YDB cluster configuration file
ydb_config: config.yaml
# Name of specific YDB configuration for storage
#   Can optionally be specified to enable custom actor system settings
# ydb_config_storage: config-storage.yaml

# Number of cores for static and dynamic nodes
ydb_cores_static: 31     # 31, if 32 cores are pinned per storage process
ydb_cores_dynamic: 14    # 14, if 16 cores are pinned per database process

# YDB physical disk device names and labels for static nodes
ydb_disks:
    - name: /dev/vdb
      label: ydb_disk_1
    - name: /dev/vdc
      label: ydb_disk_2

# The list of exactly three node brokers (static nodes)
ydb_brokers:
  - ycydb-s1
  - ycydb-s2
  - ycydb-s3

# The list of dynnodes to run on each host
#  instance is the service suffix
#  offset is the integer added to base port numbers
#  affinity is optional, and is the vCPU mask to run the service
# To check: for pid in `pgrep ydbd`; do sudo taskset -cp $pid; done
ydb_dynnodes:
  - { instance: 'a', offset: 0, affinity: '32-47' }
#  - { instance: 'b', offset: 1, affinity: '48-63' }

# Optional parameter defining the CPU affinity of static nodes' services
ydb_affinity_static: '0-31'

# Extra sleep time to allow dynamic nodes to settle up
dynnode_restart_sleep_seconds: 10

# Optional network congestion control setting, htcp recommended
ydb_congestion_setting: htcp
# Optional module to load the congestion control algorithm
ydb_congestion_module: tcp_htcp

# -----------------------------------------
# Unified Agent specific log collection setup
# -----------------------------------------

# Source path to Unified Agent binary
unified_agent_binary: ../unified_agent
# Unified Agent installation root
unified_agent_home: /opt/ydb/unified_agent

# -----------------------------------------
# Fluentbit specific log collection setup
# -----------------------------------------

# Fluentbit software with the included YDB plugin
ydb_fluentbit_archive: "../fluent-bit-ydb.tar.xz"

# Destination database for logs delivery
ydb_fluentbit_destination: "grpcs://ycydb-s1:2135/Domain0/admin"

# Logs delivery destination database trusted CA
ydb_fluentbit_ca: "/opt/ydb/cfg/ca.crt"

# Put this variable into files/secret-credentials.yml (Ansible Vault).
# ydb_fluentbit_credentials: "fluentbit:password"

# -----------------------------------------
# Loglugger specific log collection setup
# -----------------------------------------

# Source directory with prebuilt loglugger binaries on the control host.
# Expected files:
#   - loglugger-client
#   - loglugger-server
loglugger_local_bin_dir: "./loglugger/bin"

# Logical name of the client keypair inside tls/CA/clients/<logical_name>.
# Can be overridden in host_vars for per-node client certificates.
loglugger_client_cert_logical_name: "loglugger"

# Optional explicit list of server URLs for client failover.
# If omitted, URLs are built from hosts in group [loglugger_server].
# loglugger_client_servers:
#   - "https://ycydb-s1:27312"
#   - "https://ycydb-s2:27312"

# Optional systemd unit selector for client-side journald scan.
# Supports exact, glob and regex forms from loglugger:
#   nginx.service
#   nginx*.service
#   regex:^nginx-(api|worker)\\.service$
loglugger_client_service_mask: "ydbd*.service"

# Hosts selected for server component deployment can be controlled by either:
#   1) adding hosts into inventory group [loglugger_server], or
#   2) setting loglugger_server_enabled=true in host_vars/group_vars.
loglugger_server_group: loglugger_server
loglugger_server_port: 27312
loglugger_server_listen_addr: ":{{ loglugger_server_port }}"

# Loglugger server settings.
loglugger_server_ydb_endpoint: "grpcs://cluster1.domain.com:2135"
loglugger_server_ydb_database: "/Root/logdb"

loglugger_server_ydb_table: "ydblogs"
loglugger_server_position_table: "loglugger_positions"

loglugger_server_message_regex: '^(?P<P_DTTM>[^ ]*) :(?P<P_SERVICE>[^ ]*) (?P<P_LEVEL>[^ ]*): (?P<P_MESSAGE>.*).*$'
loglugger_server_systemd_unit_regex: '^ydbd-(?P<P_DBNAME>[^-]+)-.*\\.service$'
loglugger_server_message_regex_no_match: "send_raw"

# Put these variables into files/secret-credentials.yml (Ansible Vault).
# loglugger_server_ydb_auth_login: "loguser"
# loglugger_server_ydb_auth_password: "password"

# Destination field mapping is rendered from loglugger_server_field_mapping into:
#   {{ loglugger_home }}/config/field_mapping.yaml
# and referenced by server config as field_mapping_file.
# See roles/ydbd_loglugger/defaults/main.yml for defaults and example.
